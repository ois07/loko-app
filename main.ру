ет данных", "Для этого элемента справочник пуст")
            return
        self.current_element = row
        self.sel_label.text = f"Элемент: {row[1]}"
        self.load_faults()

    def load_faults(self):
        self.fault_list.clear_widgets()
        self.current_faults = self.conn.execute(
            "SELECT id, code, description FROM faults WHERE element_id=?",
            (self.current_element[0],)).fetchall()
        for f in self.current_faults:
            item = TwoLineListItem(text=f[1], secondary_text=f[2],
                on_release=lambda x, fid=f[0]: self.show_fault(fid))
            self.fault_list.add_widget(item)

    def show_fault(self, fid):
        row = self.conn.execute("SELECT code, description FROM faults WHERE id=?",
                                (fid,)).fetchone()
        series = self.series_field.text.strip() or "ТЭП70"
        norm = self.conn.execute(
            "SELECT norm, method, source FROM norms WHERE fault_id=? AND series=?",
            (fid, series)).fetchone()
        txt = f"{row[0]}: {row[1]}\n\n"
        if norm:
            txt += f"Норма ({series}): {norm[0]}\n\nМетод: {norm[1]}\n\nИсточник: {norm[2]}"
        else:
            txt += f"⚠ Норма для {series} не заполнена"
        self.show_popup("Неисправность", txt)

    def save_record(self):
        if not self.current_element:
            self.show_popup("Внимание", "Сначала выбери элемент")
            return
        self.conn.execute(
            "INSERT INTO records(series, loco_num, element, fault, inspector, date, note) "
            "VALUES (?,?,?,?,?,?,?)",
            (self.series_field.text, self.loco_field.text,
             self.current_element[1], "", self.insp_field.text,
             datetime.datetime.now().strftime("%d.%m.%Y %H:%M"), ""))
        self.conn.commit()
        self.show_popup("Готово", "Осмотр записан")

    def show_history(self):
        if not self.current_element:
            self.show_popup("Внимание", "Выбери элемент")
            return
        rows = self.conn.execute(
            "SELECT date, series, loco_num, inspector FROM records "
            "WHERE element=? ORDER BY date DESC LIMIT 15",
            (self.current_element[1],)).fetchall()
        if not rows:
            self.show_popup("История", "Записей нет")
            return
        txt = "\n\n".join(f"{d} — {s}-{n} ({i})" for d,s,n,i in rows)
        self.show_popup("История", txt)

    def save_act(self):
        if not self.current_element:
            self.show_popup("Внимание", "Выбери элемент")
            return
        path = os.path.join(os.path.expanduser("~"),
                            f"act_{datetime.datetime.now():%Y%m%d_%H%M}.txt")
        with open(path, "w", encoding="utf-8") as f:
            f.write(f"АКТ ОСМОТРА\n\nДата: {datetime.datetime.now():%d.%m.%Y %H:%M}\n"
                    f"Локомотив: {self.series_field.text} № {self.loco_field.text}\n"
                    f"Слесарь: {self.insp_field.text}\n"
                    f"Элемент: {self.current_element[1]}\n")
        self.show_popup("Акт сохранён", f"Файл:\n{path}\n\n"
                        "Можно открыть и распечатать.")

    def show_popup(self, title, text):
        if self.dialog:
            self.dialog.dismiss()
        self.dialog = MDDialog(title=title, text=text,
                               buttons=[MDFlatButton(text="OK",
                                                     on_release=lambda *a: self.dialog.dismiss())])
        self.dialog.open()

if __name__ == "__main__":
    LocoApp().run()
